# ==============================================================================
# Clientra Track - Environment Variables Template
# Copy this file to .env.local for local frontend development,
# and copy server/.env.example to server/.env for local backend development.
# Also paste these in Vercel Project Settings (Settings -> Environment Variables).
# ==============================================================================

# 1. Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# 2. Backend API URL (for local: http://localhost:5000/api/v1, or production backend URL)
VITE_API_URL="http://localhost:5000/api/v1"

# 3. Twilio WhatsApp Credentials (from twilio.com/console)
# (Keep Account SID & Auth Token safe in backend server/.env; do NOT expose token to browser)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# 4. Email Notifications (Resend API Key from resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
